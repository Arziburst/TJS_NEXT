{
  "name": "tjs-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.6.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "presupabase:start": "pwsh -NoProfile -File scripts/dev/Assert-NotSharedMainFromWorktree.ps1",
    "supabase:start": "supabase start",
    "presupabase:stop": "pwsh -NoProfile -File scripts/dev/Assert-NotSharedMainFromWorktree.ps1",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:start:worktree": "pwsh -NoProfile -File scripts/dev/Start-WorktreeSupabase.ps1",
    "supabase:stop:worktree": "pwsh -NoProfile -File scripts/dev/Stop-WorktreeSupabase.ps1",
    "supabase:cleanup": "pwsh -NoProfile -File scripts/dev/Remove-StaleSupabaseWorktrees.ps1 -RepoPath .",
    "predb:reset": "pwsh -NoProfile -File scripts/dev/Assert-NotSharedMainFromWorktree.ps1",
    "db:reset": "supabase db reset",
    "predb:types": "pwsh -NoProfile -File scripts/dev/Assert-NotSharedMainFromWorktree.ps1",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "pretest:db": "pwsh -NoProfile -File scripts/dev/Assert-NotSharedMainFromWorktree.ps1",
    "test:db": "supabase test db",
    "check:migrations": "node scripts/ci/check-migration-versions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "shadcn": "4.21.5",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
