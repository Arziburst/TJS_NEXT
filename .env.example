# Environment variables — names only, never real values. Copy to .env.local (git-ignored).
# Each task that reads a new variable adds its name here with who reads it and whether it is public.
# NEXT_PUBLIC_* values are bundled into client code: never put a secret in one.
# Feature flags are on only when the value is exactly "true".

# Site origin for canonical and hreflang URLs (src/i18n/metadata.ts) and for the links in auth emails and the
# Google redirect (src/lib/auth/site-url.ts). Public, not a secret. Optional:
# without it Vercel's VERCEL_PROJECT_PRODUCTION_URL is used, else http://localhost:<PORT>.
NEXT_PUBLIC_SITE_URL=

# TJS_UI_KIT: "true" serves the /ui-kit design-system showcase (src/app/[locale]/ui-kit); anything else is a 404.
# Server-only, not a secret. Set it in .env.local to see the page in dev; CI sets it for the build and e2e;
# never set it on Vercel.
TJS_UI_KIT=

# Supabase (src/lib/supabase/). A worktree's `npm run supabase:start:worktree` writes all three into .env.local.
# NEXT_PUBLIC_SUPABASE_URL: the project's API URL. Public.
NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY: the anon key; RLS decides what it may read. Public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY: bypasses RLS. SECRET, server-only: never in a NEXT_PUBLIC_* name or client code.
# Required wherever the app runs: the auth rate limit counts through it (src/lib/auth/rate-limit.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Playwright (npm run test:e2e). Optional.
# E2E_BASE_URL: run against an already running app instead of starting `next dev`.
E2E_BASE_URL=
# E2E_PORT: port for the dev server Playwright starts (default 3000; a worktree for issue <n> uses 3000 + <n>).
E2E_PORT=
# E2E_SERVER: "start" makes Playwright serve the production build (`next start`, run `npm run build` first)
# instead of `next dev`; CI sets it.
E2E_SERVER=

# NOVA_POSHTA_API_KEY: the Nova Poshta API 2.0 key (src/lib/delivery/nova-poshta/client.ts). SECRET, server-only:
# never in a NEXT_PUBLIC_* name. Optional: without it the app calls the API without a key (its dictionaries and
# prices answer without one).
NOVA_POSHTA_API_KEY=
# NOVA_POSHTA_FIXTURES: "true" answers Nova Poshta from the recorded fixtures instead of the network (local walks,
# e2e). Server-only, not a secret; never set it on Vercel (refused when VERCEL_ENV=production).
NOVA_POSHTA_FIXTURES=

# Vercel Cron (vercel.json → /api/cron/fx-rates, /api/cron/nova-poshta) sends it as `Authorization: Bearer …`. A secret.
# Without it the cron route answers 401 to every call.
CRON_SECRET=

# Nova Post international delivery (src/lib/delivery/nova-post/), EU + CH. Server-only.
# NOVA_POST_API_KEY: the API key of the owner's Nova Post contract. SECRET, never in a NEXT_PUBLIC_* name.
# Unset (no contract yet): no branch search, and every estimate is the zone flat rate (nova_post_zone_rates).
NOVA_POST_API_KEY=
# NOVA_POST_API_URL: the API base URL. Optional, default production https://api.novapost.com/v.1.0; the
# sandbox is https://api-stage.novapost.com/v.1.0 (a sandbox key: POST /test-api-keys, see the API docs);
# local dev and e2e point it at the fixture server (node e2e/nova-post-mock.ts, docs/dev-environment.md).
NOVA_POST_API_URL=

# Machine translation of product texts in the admin (src/lib/translate/, docs/dev-environment.md). Server-only.
# AI_GATEWAY_API_KEY: a Vercel AI Gateway key. SECRET, never in a NEXT_PUBLIC_* name. Local development; unset (and no
# AI_GATEWAY_OIDC) → the admin shows "machine translation is not configured".
AI_GATEWAY_API_KEY=
# AI_GATEWAY_OIDC: "true" on Vercel authenticates with the deployment's OIDC token instead of a key. Not a secret.
AI_GATEWAY_OIDC=
# AI_GATEWAY_BASE_URL: another gateway URL (the e2e stand-in, node e2e/ai-gateway-mock.ts). Optional; ignored when
# VERCEL_ENV=production.
AI_GATEWAY_BASE_URL=

# Order notifications (src/lib/notifications/, docs/dev-environment.md "Notifications"). Server-only.
# NOTIFICATIONS_SEND: "true" lets messages go out (the production deployment only). Anything else: nothing is sent,
# every message is marked skipped_unconfigured, even with the keys below set. Not a secret.
NOTIFICATIONS_SEND=
# TELEGRAM_BOT_TOKEN: the bot that posts to the owner's group. SECRET, never in a NEXT_PUBLIC_* name. TBD (the owner).
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID: the owner's group (a negative id for groups). TBD (the owner); moves to the admin settings (#21).
TELEGRAM_CHAT_ID=
# RESEND_API_KEY: the Resend API key for the customer's emails. SECRET. TBD (the owner).
RESEND_API_KEY=
# EMAIL_FROM: the sender, "Name <address>" on a domain verified in Resend. TBD (the owner decides address and domain).
EMAIL_FROM=
# EMAIL_REPLY_TO: optional address the customer's replies go to.
EMAIL_REPLY_TO=
# TELEGRAM_API_BASE_URL, RESEND_API_URL: local dev and e2e only, the stand-in (node e2e/notifications-mock.ts);
# unset in production (defaults https://api.telegram.org and https://api.resend.com).
TELEGRAM_API_BASE_URL=
RESEND_API_URL=
